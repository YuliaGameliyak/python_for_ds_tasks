            "text/plain": [
              "[1200, 1850, 900, 2100, 1750, 3200, 2800]"
            ]
          },
          "execution_count": 68,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "# Продажі за 7 днів тижня\n",
        "sales = [1200, 1850, 900, 2100, 1750, 3200, 2800]\n",
        "cities = [\"Київ\", \"Львів\", \"Одеса\", \"Харків\"]\n",
