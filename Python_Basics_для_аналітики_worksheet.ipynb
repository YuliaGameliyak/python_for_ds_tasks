          "output_type": "stream",
          "text": [
            "Відпали: {'Анна', 'Іван'}\n"
          ]
        }
      ],
      "source": [
        "# Хто був у січні, але зник у лютому? (різниця)\n",
        "print(\"Відпали:\", buyers_january - buyers_february)"
      ]
