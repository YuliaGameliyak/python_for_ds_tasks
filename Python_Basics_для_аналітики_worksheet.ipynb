              " 'city': 'Київ',\n",
              " 'orders': 12,\n",
              " 'total_spent': 45300.5,\n",
              " 'is_active': True}"
            ]
          },
          "execution_count": 128,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "# Один клієнт як словник\n",
        "customer = {\n",
        "    \"name\": \"Іван Коваленко\",\n",
        "    \"city\": \"Київ\",\n",
